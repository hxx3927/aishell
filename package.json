{
  "name": "aishell",
  "version": "0.1.0",
  "description": "AI-native SSH workbench: terminal, SFTP and local AI agents in one place",
  "main": "./out/main/index.js",
  "author": "AIShell",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build:win": "npm run typecheck && electron-vite build && electron-builder --win",
    "mock:ssh": "node scripts/mock-ssh-server.mjs",
    "test": "npm run test:audit && npm run test:monitor && npm run test:monitor-compute && npm run test:agent-shell && npm run test:agent-shell-bash",
    "test:audit": "esbuild scripts/test-audit-store.mts --bundle --platform=node --format=cjs --external:electron --outfile=scripts/.tmp-audit-store.cjs && node scripts/.tmp-audit-store.cjs",
    "test:monitor": "esbuild scripts/test-monitor-parse.mts --bundle --platform=node --format=cjs --outfile=scripts/.tmp-monitor-parse.cjs && node scripts/.tmp-monitor-parse.cjs",
    "test:monitor-compute": "esbuild scripts/test-monitor-compute.mts --bundle --platform=node --format=cjs --outfile=scripts/.tmp-monitor-compute.cjs && node scripts/.tmp-monitor-compute.cjs",
    "test:agent-shell": "esbuild scripts/test-agent-shell.mts --bundle --platform=node --format=esm --external:ssh2 --outfile=scripts/.tmp-agent-shell.mjs && node scripts/.tmp-agent-shell.mjs",
    "test:agent-shell-bash": "esbuild scripts/test-agent-shell-bash.mts --bundle --platform=node --format=esm --external:ssh2 --outfile=scripts/.tmp-agent-shell-bash.mjs && node scripts/.tmp-agent-shell-bash.mjs"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.9.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@uiw/react-codemirror": "^4.25.12",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.67.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ssh2": "^1.17.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  }
}
